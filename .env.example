# Which LLM provider the pipeline uses: "openai" or "ollama"
PROVIDER=openai

# OpenAI (used when PROVIDER=openai)
OPENAI_API_KEY=

# Local Ollama server base URL (used when PROVIDER=ollama), e.g. http://localhost:11434
LLAMA_BASE_URL=

# Crunchbase Basic API key (optional, enriches company data in step1)
CRUNCHBASE_API_KEY=

# Directory for the relational table CSVs (default ./data)
DATA_DIR=./data
