# Which LLM provider the pipeline uses: "openai" or "ollama"
PROVIDER=openai

# OpenAI (used when PROVIDER=openai)
OPENAI_API_KEY=

# Local Ollama server base URL (used when PROVIDER=ollama), e.g. http://localhost:11434
LLAMA_BASE_URL=

# Crunchbase Basic API key (optional, enriches company data in step1)
CRUNCHBASE_API_KEY=

# Root data dir. Holds input/ (curated seed), scraped/ (step0 output), and
# output/<run>/ (timestamped run folders). Default ./data.
DATA_DIR=./data

# Reference date for the outcome derivation (company age / recency). Default: now.
BUILD_DATE=
