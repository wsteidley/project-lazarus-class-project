{
  "name": "project-lazarus",
  "version": "1.0.0",
  "description": "Turn scraped TechCrunch articles into a structured dataset of climate-tech startups using LLMs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "step0": "tsx src/steps/step0-scrape.ts",
    "step1": "tsx src/steps/step1-extract-company.ts",
    "step1b": "tsx src/steps/step1b-extract-dependencies.ts",
    "step1c": "tsx src/steps/step1c-resolve-dependencies.ts",
    "resolve": "tsx src/steps/resolve-companies.ts",
    "resolve:fuzzy": "tsx src/steps/resolve-fuzzy.ts",
    "resolve:apply": "tsx src/steps/apply-merge-candidates.ts",
    "lint:py": "uv run --project resolve ruff check resolve",
    "enrich": "tsx src/steps/enrich-companies.ts",
    "step2": "tsx src/steps/step2-add-funding.ts",
    "step3": "tsx src/steps/step3-cleanup-funding.ts",
    "outcome-pass": "tsx src/steps/outcome-pass.ts",
    "derive": "tsx src/steps/derive-outcomes.ts",
    "reassess": "tsx src/steps/reassess.ts",
    "build": "tsx src/steps/build-db.ts",
    "clean": "tsx src/steps/clean.ts",
    "build-sources": "tsx src/sources/build-sources.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@langchain/tavily": "^1.2.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^16.4.5",
    "duck-duck-scrape": "^2.2.7",
    "langchain": "^1.5.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
